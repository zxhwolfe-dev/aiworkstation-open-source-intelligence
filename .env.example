# Default: deterministic local fixture data with no network access.
OSI_PROVIDER=mock

# Runtime telemetry defaults to WARNING and writes privacy-minimized JSON events
# to stderr. INFO additionally records successful tool name/outcome/duration and
# safe aggregate counts. Query text, constraints, project IDs and raw request IDs
# are never accepted by the telemetry event API.
# OSI_LOG_LEVEL=WARNING
# Supported: OFF, ERROR, WARNING, INFO

# Enable the public AI Workstation Radar HTTP adapter explicitly:
# OSI_PROVIDER=http
# AIWORKSTATION_RADAR_BASE_URL=https://aiworkstation.cn
# OSI_HTTP_TIMEOUT_SECONDS=30
# OSI_HYDRATE_LIMIT=5

# Local Streamable HTTP development server. Safe defaults bind only to loopback
# and use the mock provider unless OSI_PROVIDER is changed explicitly:
# OSI_MCP_HTTP_HOST=127.0.0.1
# OSI_MCP_HTTP_PORT=8000
# OSI_MCP_HTTP_MAX_REQUEST_BODY_BYTES=262144

# Container/reverse-proxy private alpha. A non-loopback process bind requires all
# of these. The acknowledgement does NOT provide authentication; it only confirms
# that the operator is placing the service behind a trusted private network or
# authenticated TLS reverse proxy.
# OSI_MCP_HTTP_HOST=0.0.0.0
# OSI_MCP_HTTP_PUBLIC_BIND_ACK=reverse-proxy-or-private-network
# OSI_PROVIDER=http
# AIWORKSTATION_RADAR_BASE_URL=https://aiworkstation.cn

# MCP SDK DNS-rebinding protection. Use the exact Host header values your trusted
# proxy/client will send. For a real hostname normally include both bare host and
# host:* if variable ports are intentionally accepted.
# OSI_MCP_HTTP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*

# Browser MCP clients also send Origin. Leave empty for non-browser clients. If
# browsers are allowed, list exact HTTPS origins and configure matching narrow
# CORS rules at the gateway/application layer.
# OSI_MCP_HTTP_ALLOWED_ORIGINS=https://app.example.com

# There is intentionally no "assume authentication" switch. Do not expose the
# Streamable HTTP endpoint directly to the Internet until native OAuth or a
# trusted authenticated gateway is configured and tested.
