# AI Open Source Intelligence — public Hosted MCP reverse proxy
#
# Install only after DNS for mcp.aiworkstation.cn points at this host and a valid
# TLS certificate exists. The Hosted MCP container/process itself remains bound
# to 127.0.0.1:8001 on the host.
#
# Current product mode is anonymous, read-only and data-only. There is no OAuth,
# Premium or AI Workstation server-model route in this release. The gateway owns
# the anonymous abuse boundary with both short-window and sustained per-IP limits.

# Short-window protection: normal research can make several tool calls quickly.
limit_req_zone $binary_remote_addr zone=osi_mcp_public:10m rate=60r/m;

# Sustained protection: a script cannot keep the short-window rate all day.
# A generous burst preserves normal multi-tool research sessions while reducing
# long-running scraping/abuse after that burst is consumed.
limit_req_zone $binary_remote_addr zone=osi_mcp_sustained:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=osi_mcp_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name mcp.aiworkstation.cn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.aiworkstation.cn;

    ssl_certificate /etc/letsencrypt/live/mcp.aiworkstation.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.aiworkstation.cn/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    limit_req_status 429;

    location = /mcp {
        limit_req zone=osi_mcp_public burst=30 nodelay;
        limit_req zone=osi_mcp_sustained burst=300 nodelay;
        limit_conn osi_mcp_conn 10;
        add_header X-OSI-Hosted-Gateway-Policy "tls-ip-rate-limited" always;

        proxy_pass http://127.0.0.1:8001/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 256k;
    }

    # Everything other than the MCP endpoint is intentionally closed on this
    # dedicated hostname. OAuth discovery is not exposed in the data-only release.
    location / {
        return 404;
    }
}
