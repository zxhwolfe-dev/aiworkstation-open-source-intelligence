# AI Open Source Intelligence — public Hosted MCP reverse proxy
#
# Install only after DNS for mcp.aiworkstation.cn points at this host and a valid
# TLS certificate exists. The Hosted MCP container/process itself remains bound
# to 127.0.0.1:8001 on the host.
#
# Replace certificate paths with the production certificate paths generated by
# your ACME/Certbot workflow. Never expose 127.0.0.1:8001 directly to the public
# Internet.
#
# Public Hosted mode is intentionally anonymous and read-only. Because there is
# no per-user OAuth identity in that mode, the gateway owns the first abuse
# boundary with bounded per-IP request and connection limits. OAuth mode keeps
# these controls as defense in depth.

limit_req_zone $binary_remote_addr zone=osi_mcp_public:10m rate=120r/m;
limit_conn_zone $binary_remote_addr zone=osi_mcp_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name mcp.aiworkstation.cn;

    # Keep HTTP available only for ACME challenge / canonical HTTPS redirect.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.aiworkstation.cn;

    ssl_certificate /etc/letsencrypt/live/mcp.aiworkstation.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.aiworkstation.cn/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    limit_req_status 429;

    location = /mcp {
        limit_req zone=osi_mcp_public burst=60 nodelay;
        limit_conn osi_mcp_conn 20;
        add_header X-OSI-Hosted-Gateway-Policy "tls-ip-rate-limited" always;

        proxy_pass http://127.0.0.1:8001/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 256k;
    }

    # OAuth protected-resource metadata remains available only when the Hosted
    # application runs in oauth mode. In public mode the upstream may return a
    # non-success status; the paths stay closed to arbitrary proxying either way.
    location = /.well-known/oauth-protected-resource {
        limit_req zone=osi_mcp_public burst=30 nodelay;
        add_header X-OSI-Hosted-Gateway-Policy "tls-ip-rate-limited" always;
        proxy_pass http://127.0.0.1:8001/.well-known/oauth-protected-resource;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        client_max_body_size 64k;
    }

    location = /.well-known/oauth-protected-resource/mcp {
        limit_req zone=osi_mcp_public burst=30 nodelay;
        add_header X-OSI-Hosted-Gateway-Policy "tls-ip-rate-limited" always;
        proxy_pass http://127.0.0.1:8001/.well-known/oauth-protected-resource/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        client_max_body_size 64k;
    }

    # Everything else on this dedicated hostname is intentionally closed.
    location / {
        return 404;
    }
}
