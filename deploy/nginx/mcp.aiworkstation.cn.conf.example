# AI Open Source Intelligence — public Hosted MCP reverse proxy
#
# Install only after DNS for mcp.aiworkstation.cn points at this host and a valid
# TLS certificate exists. The Hosted MCP container/process itself remains bound
# to 127.0.0.1:8001 on the host.
#
# Replace certificate paths with the production certificate paths generated by
# your ACME/Certbot workflow. Never expose 127.0.0.1:8001 directly to the public
# Internet.

server {
    listen 80;
    listen [::]:80;
    server_name mcp.aiworkstation.cn;

    # Keep HTTP available only for ACME challenge / canonical HTTPS redirect.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mcp.aiworkstation.cn;

    ssl_certificate /etc/letsencrypt/live/mcp.aiworkstation.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.aiworkstation.cn/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    # MCP Python SDK exposes RFC 9728 protected-resource metadata from the same
    # ASGI app. Allow only MCP plus its OAuth discovery/resource metadata paths.
    location = /mcp {
        proxy_pass http://127.0.0.1:8001/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 256k;
    }

    location = /.well-known/oauth-protected-resource {
        proxy_pass http://127.0.0.1:8001/.well-known/oauth-protected-resource;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        client_max_body_size 64k;
    }

    # Some clients resolve resource metadata relative to the MCP path. The SDK
    # may expose this RFC 9728 variant; proxy it without opening a wildcard path.
    location = /.well-known/oauth-protected-resource/mcp {
        proxy_pass http://127.0.0.1:8001/.well-known/oauth-protected-resource/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        client_max_body_size 64k;
    }

    # Everything else on this dedicated hostname is intentionally closed.
    location / {
        return 404;
    }
}
