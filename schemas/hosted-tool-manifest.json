{
  "schema_version": "osi.hosted-tool-manifest.v1",
  "status": "hosted-public-preparation",
  "base_manifest": "schemas/tool-manifest.json",
  "authentication": {
    "required": true,
    "scheme": "OAuth 2.1 resource server",
    "required_scopes": []
  },
  "base_tools": [
    "search_ai_projects",
    "get_project_facts",
    "get_license_evidence",
    "compare_ai_projects",
    "find_alternatives",
    "compose_ai_stack",
    "get_radar_overview",
    "browse_radar_projects",
    "browse_radar_skills"
  ],
  "hosted_only_tools": [
    {
      "name": "deep_research_ai_projects",
      "description": "Run publisher-model deep research over rules-first public Radar results. The first successful premium task is free; later tasks require AI credits.",
      "annotations": {
        "read_only": false,
        "destructive": false,
        "idempotent": false,
        "open_world": true
      },
      "billing_behavior": {
        "ordinary_data_tools_consume_ai_credits": false,
        "first_successful_premium_task_free": true,
        "credit_cost": 1,
        "failed_model_requests_refund_reservation": true,
        "upgrade_may_return_checkout_url": true
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "focus": {
            "enum": ["research", "comparison", "stack", "market_scan"],
            "default": "research"
          },
          "filters": {
            "type": "object",
            "maxProperties": 50,
            "description": "Optional public Radar selector constraints. Internal publication fields are never accepted as model context."
          },
          "locale": {
            "enum": ["zh", "en"],
            "default": "en"
          }
        }
      }
    }
  ]
}
