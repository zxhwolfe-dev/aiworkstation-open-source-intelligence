{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworkstation.cn/schemas/osi/tool-result.schema.json",
  "title": "AI Workstation Open Source Intelligence Tool Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "data", "verified_facts", "recommendations", "unknowns", "risks", "execution", "generated_at", "request_id"],
  "properties": {
    "schema_version": {"const": "osi.tool-result.v2"},
    "tool": {"enum": ["search_ai_projects", "get_project_facts", "get_license_evidence", "compare_ai_projects", "find_alternatives", "compose_ai_stack", "get_radar_overview", "browse_radar_projects", "browse_radar_skills"]},
    "data": {"type": "object"},
    "verified_facts": {"type": "array", "items": {"$ref": "#/$defs/verifiedFact"}},
    "recommendations": {"type": "array", "items": {"$ref": "#/$defs/recommendation"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["business_data_write", "ephemeral_control_plane_effects"],
      "properties": {
        "business_data_write": {"const": false},
        "ephemeral_control_plane_effects": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generated_at": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "maxLength": 128}
  },
  "$defs": {
    "verifiedFact": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "value", "confidence", "evidence"],
      "properties": {
        "field": {"type": "string", "minLength": 1}, "value": {},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_url", "observed_at", "source_type", "excerpt", "supports"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1}, "excerpt": {"type": "string", "maxLength": 2000},
        "supports": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "rationale", "assumptions"],
      "properties": {"summary": {"type": "string", "minLength": 1}, "rationale": {"type": "array", "items": {"type": "string"}}, "assumptions": {"type": "array", "items": {"type": "string"}}}
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "severity": {"enum": ["low", "medium", "high"]}}
    }
  }
}
