{
  "schema_version": "osi.tool-manifest.v1",
  "status": "0.3-release-candidate",
  "runtime_limits": {
    "structured_max_depth": 6,
    "structured_max_nodes": 200,
    "structured_max_container_items": 50,
    "structured_max_key_length": 128,
    "structured_max_string_length": 1000
  },
  "tools": [
    {
      "name": "search_ai_projects",
      "description": "Find open-source AI projects from explicit requirements and constraints.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "$defs": {
          "structuredValue": {
            "anyOf": [
              {"type": "string", "maxLength": 1000},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"},
              {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/structuredValue"}},
              {"type": "object", "maxProperties": 50, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$"}, "additionalProperties": {"$ref": "#/$defs/structuredValue"}}
            ]
          }
        },
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 4000},
          "constraints": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/constraint"}, "description": "Typed constraints preserving required, preferred and excluded intent."},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    },
    {
      "name": "get_project_facts",
      "description": "Return current evidence-backed facts for one project.",
      "read_only": true,
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["project_id"], "properties": {"project_id": {"type": "string", "minLength": 1, "maxLength": 256}, "locale": {"enum": ["zh", "en"], "default": "en"}, "request_id": {"type": "string", "maxLength": 128}}}
    },
    {
      "name": "get_license_evidence",
      "description": "Return observed license evidence without legal conclusions.",
      "read_only": true,
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["project_id"], "properties": {"project_id": {"type": "string", "minLength": 1, "maxLength": 256}, "locale": {"enum": ["zh", "en"], "default": "en"}, "request_id": {"type": "string", "maxLength": 128}}}
    },
    {
      "name": "compare_ai_projects",
      "description": "Compare two to five projects against explicit criteria.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_ids"],
        "$defs": {"structuredValue": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/structuredValue"}}, {"type": "object", "maxProperties": 50, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$"}, "additionalProperties": {"$ref": "#/$defs/structuredValue"}}]}, "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "value", "polarity"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"$ref": "#/$defs/structuredValue"}, "polarity": {"enum": ["required", "preferred", "excluded"]}}}},
        "properties": {
          "project_ids": {"type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "criteria": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "context": {"type": "object", "maxProperties": 50, "description": "JSON-compatible decision context. Runtime additionally limits total nodes and nesting depth.", "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$"}, "additionalProperties": {"$ref": "#/$defs/structuredValue"}},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    },
    {
      "name": "find_alternatives",
      "description": "Find candidate alternatives to a named project.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id"],
        "$defs": {"structuredValue": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/structuredValue"}}, {"type": "object", "maxProperties": 50, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$"}, "additionalProperties": {"$ref": "#/$defs/structuredValue"}}]}, "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "value", "polarity"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"$ref": "#/$defs/structuredValue"}, "polarity": {"enum": ["required", "preferred", "excluded"]}}}},
        "properties": {
          "project_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "constraints": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/constraint"}},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    },
    {
      "name": "compose_ai_stack",
      "description": "Compose a candidate stack from a business goal and constraints.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["business_goal"],
        "$defs": {"structuredValue": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/structuredValue"}}, {"type": "object", "maxProperties": 50, "propertyNames": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F]+$"}, "additionalProperties": {"$ref": "#/$defs/structuredValue"}}]}},
        "properties": {
          "business_goal": {"type": "string", "minLength": 1, "maxLength": 4000},
          "constraints": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/constraint"}},
          "existing_stack": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    },
    {
      "name": "get_radar_overview",
      "description": "List current Radar rankings, collections, categories, scenarios and other navigation dimensions.",
      "read_only": true,
      "input_schema": {"type": "object", "additionalProperties": false, "properties": {"locale": {"enum": ["zh", "en"], "default": "en"}, "request_id": {"type": "string", "maxLength": 128}}}
    },
    {
      "name": "browse_radar_projects",
      "description": "Browse Radar projects by ranking, collection, category, scenario, topic, search text and public filters.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {"type": "string", "maxLength": 1000},
          "ranking": {"type": "string", "maxLength": 256},
          "collection": {"type": "string", "maxLength": 256},
          "category": {"type": "string", "maxLength": 256},
          "scenario": {"type": "string", "maxLength": 256},
          "role": {"type": "string", "maxLength": 256},
          "topic": {"type": "string", "maxLength": 256},
          "github_topic": {"type": "string", "maxLength": 256},
          "radar_topic": {"type": "string", "maxLength": 256},
          "use_case": {"type": "string", "maxLength": 256},
          "resource_type": {"type": "string", "maxLength": 256},
          "license": {"type": "string", "maxLength": 256},
          "deployment": {"type": "string", "maxLength": 256},
          "layer": {"type": "string", "maxLength": 256},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20},
          "offset": {"type": "integer", "minimum": 0, "maximum": 10000, "default": 0},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    },
    {
      "name": "browse_radar_skills",
      "description": "Browse, filter and search the AI Open Source Radar Skills library, or open one Skill by ID.",
      "read_only": true,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "skill_id": {"type": "string", "maxLength": 512},
          "query": {"type": "string", "maxLength": 1000},
          "category": {"type": "string", "maxLength": 256},
          "kind": {"type": "string", "maxLength": 256},
          "license": {"type": "string", "maxLength": 256},
          "installable": {"type": "boolean", "default": false},
          "sort": {"type": "string", "maxLength": 256},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20},
          "offset": {"type": "integer", "minimum": 0, "maximum": 10000, "default": 0},
          "locale": {"enum": ["zh", "en"], "default": "en"},
          "request_id": {"type": "string", "maxLength": 128}
        }
      }
    }
  ]
}
